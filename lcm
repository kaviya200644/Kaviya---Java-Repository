import java.util.Scanner;

public class LCM {

    static int lcm(int a, int b) {
        int max = (a > b) ? a : b;

        while(true) {
            if(max % a == 0 && max % b == 0)
                return max;

            max++;
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int a = sc.nextInt();
        int b = sc.nextInt();

        System.out.println(lcm(a, b));

        sc.close();
    }
}
