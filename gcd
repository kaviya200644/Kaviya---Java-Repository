import java.util.Scanner;

public class GCD {

    static int gcd(int a, int b) {
        int g = 1;

        for(int i = 1; i <= a && i <= b; i++) {
            if(a % i == 0 && b % i == 0)
                g = i;
        }

        return g;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int a = sc.nextInt();
        int b = sc.nextInt();

        System.out.println(gcd(a, b));

        sc.close();
    }
}
